        <mxCell id="e_core_payments" edge="1" parent="tier2" source="wp_core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.665;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#B9770E;strokeWidth=3;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="mod_payments" value="WC Payment Hooks">
          <mxGeometry relative="1" as="geometry" />
