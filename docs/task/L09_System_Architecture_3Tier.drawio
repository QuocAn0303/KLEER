        </mxCell>
        <mxCell id="ext_acme" parent="ext_tier" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EBDEF0;strokeColor=#7D3C98;strokeWidth=2;align=left;spacingLeft=14;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Let&#39;s Encrypt CA&lt;/b&gt;&lt;br/&gt;• ACME HTTP-01 API&lt;br/&gt;• Cấp &amp;amp; gia hạn TLS tự động" vertex="1">
          <mxGeometry height="80" width="250" x="960" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_vnpay" parent="ext_tier" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2;align=left;spacingLeft=14;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;VNPay Sandbox Gateway&lt;/b&gt;&lt;br/&gt;• Payment Page &amp;amp; IPN Callback&lt;br/&gt;• Chuẩn ký số HMAC-SHA512" vertex="1">
          <mxGeometry height="80" width="270" x="1260" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_vietqr" parent="ext_tier" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2;align=left;spacingLeft=14;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Ngân hàng / Napas 247&lt;/b&gt;&lt;br/&gt;• Chuyển khoản VietQR động&lt;br/&gt;• Chuẩn EMVCo Payload" vertex="1">
          <mxGeometry height="80" width="270" x="1580" y="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_smtp" parent="ext_tier" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;align=left;spacingLeft=14;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;SMTP Mail Server (Prod)&lt;/b&gt;&lt;br/&gt;• Giao thức SMTP / TLS (465/587)&lt;br/&gt;• Gửi Email Hóa đơn &amp;amp; Voucher" vertex="1">
          <mxGeometry height="80" width="260" x="1900" y="45" as="geometry" />
        </mxCell>
        <mxCell id="docker_host" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fontStyle=1;fontSize=15;fillColor=#FBFCFC;strokeColor=#2C3E50;strokeWidth=3;swimlaneFillColor=#FBFCFC;rounded=1;" value="DOCKER HOST / VPS — ISOLATED BRIDGE NETWORK (kleer-net)" vertex="1">
          <mxGeometry height="1300" width="2340" x="30" y="290" as="geometry" />
        </mxCell>
        <mxCell id="tier2" parent="docker_host" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;swimlaneFillColor=#EAF2F8;rounded=1;arcSize=28;" value="TIER 2 — APPLICATION &amp; BUSINESS LOGIC TIER (Container: kleer-php | php:8.2-fpm — WordPress + Microkernel Architecture)" vertex="1">
          <mxGeometry height="580" width="2130" x="55" y="325" as="geometry" />
        </mxCell>
        <mxCell id="wp_core" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#D4E6F1;strokeColor=#1A5276;strokeWidth=2;align=left;spacingLeft=18;lineHeight=1.35;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Nhân Nền Tảng (WordPress 6.x Kernel &amp;amp; WooCommerce 8.x Platform)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;WordPress Core:&lt;/b&gt; WP REST API, Hooks (Actions/Filters), WP-Cron, Session &amp;amp; Nonce Security&lt;br/&gt;• &lt;b&gt;WooCommerce Core:&lt;/b&gt; HPOS Order Tables, Product Lookup Tables, Cart &amp;amp; Checkout Engine, WC REST API v3" vertex="1">
          <mxGeometry height="82" width="2060" x="35" y="48" as="geometry" />
        </mxCell>
        <mxCell id="mod_theme" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.3;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Module 1: kleer-theme (Presentation)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Templates:&lt;/b&gt; PHP thuần (front-page, catalog, single)&lt;br/&gt;• &lt;b&gt;Frontend:&lt;/b&gt; CSS BEM + Vanilla JS ES6 (Zero Builder)&lt;br/&gt;• &lt;b&gt;SPA Modules:&lt;/b&gt;&lt;br/&gt;  - &lt;i&gt;quiz.js:&lt;/i&gt; 6 bước chẩn đoán da&lt;br/&gt;  - &lt;i&gt;catalog-filter.js:&lt;/i&gt; Lọc AJAX đa tiêu chí&lt;br/&gt;  - &lt;i&gt;routine-cart.js:&lt;/i&gt; Giỏ hàng &amp;amp; cảnh báo xung đột" vertex="1">
          <mxGeometry height="190" width="420" x="35" y="175" as="geometry" />
        </mxCell>
        <mxCell id="mod_plugin" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#AED6F1;strokeColor=#1B4F72;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.3;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Module 2: kleer-plugin (Core Business &amp;amp; REST API — PSR-4)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;REST Endpoints:&lt;/b&gt; &lt;i&gt;/kleer/v1/skin-quiz&lt;/i&gt;, &lt;i&gt;/health&lt;/i&gt; (JSON Schema Validation)&lt;br/&gt;• &lt;b&gt;Domain Services:&lt;/b&gt;&lt;br/&gt;  - &lt;i&gt;QuizEngineService:&lt;/i&gt; Thuật toán chấm điểm Routine v4&lt;br/&gt;  - &lt;i&gt;CartComboService:&lt;/i&gt; Giảm 15% (≥3 bước) &amp;amp; chặn xung đột AHA/BHA + Retinol&lt;br/&gt;  - &lt;i&gt;HposService &amp;amp; InstantRefundService:&lt;/i&gt; Đồng bộ đơn &amp;amp; hoàn tiền Store Credit&lt;br/&gt;• &lt;b&gt;Repositories &amp;amp; Cache:&lt;/b&gt; Product/Routine Repo, &lt;i&gt;KleerCache&lt;/i&gt;, HPOS Compatibility" vertex="1">
          <mxGeometry height="190" width="590" x="515" y="175" as="geometry" />
        </mxCell>
        <mxCell id="mod_payments" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.3;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Module 3: kleer-payments (Payment Gateways)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;VNPay Sandbox:&lt;/b&gt;&lt;br/&gt;  - Tạo URL thanh toán &amp;amp; ký số HMAC-SHA512&lt;br/&gt;  - Xử lý Webhook IPN (Server-to-Server) &amp;amp; Return URL&lt;br/&gt;• &lt;b&gt;VietQR / Napas 247:&lt;/b&gt;&lt;br/&gt;  - Sinh mã QR động chuẩn EMVCo tại Checkout&lt;br/&gt;• &lt;b&gt;Phương thức hỗ trợ:&lt;/b&gt; COD, VietQR, VNPay" vertex="1">
          <mxGeometry height="190" width="445" x="1165" y="175" as="geometry" />
        </mxCell>
        <mxCell id="mod_mailer" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FADBD8;strokeColor=#A93226;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.3;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Module 4: kleer-mailer (Transactional Email)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Email Hóa đơn:&lt;/b&gt; HTML đính kèm mã QR PNG tra cứu đơn hàng (&lt;i&gt;woocommerce_order_email&lt;/i&gt;)&lt;br/&gt;• &lt;b&gt;Email Hoàn tiền:&lt;/b&gt; Cấp mã Coupon Store Credit tự động ngay khi kích hoạt hoàn tiền nhanh&lt;br/&gt;• &lt;b&gt;Transport:&lt;/b&gt; Cấu hình SMTP TLS / Mailpit Sink" vertex="1">
          <mxGeometry height="190" width="430" x="1665" y="175" as="geometry" />
        </mxCell>
        <mxCell id="support_label" parent="tier2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1A5276;" value="Dịch vụ Định tuyến, Tác vụ Nền &amp; Công cụ Kiểm thử Nội bộ (kleer-net)" vertex="1">
          <mxGeometry height="24" width="600" x="35" y="395" as="geometry" />
        </mxCell>
        <mxCell id="rest_router" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:13.5px;&quot;&gt;WP REST API &amp;amp; WooCommerce Router&lt;/b&gt;&lt;br/&gt;• Custom API: &lt;i&gt;/wp-json/kleer/v1/*&lt;/i&gt;&lt;br/&gt;• Store &amp;amp; Cart API: &lt;i&gt;/wp-json/wc/v3/*&lt;/i&gt;" vertex="1">
          <mxGeometry height="125" width="420" x="35" y="425" as="geometry" />
        </mxCell>
        <mxCell id="cron_worker" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:13.5px;&quot;&gt;WP-Cron &amp;amp; Background Workers&lt;/b&gt;&lt;br/&gt;• Xử lý bất đồng bộ: Gửi佇 email SMTP, đối soát IPN trễ&lt;br/&gt;• Dọn dẹp Session hết hạn &amp;amp; làm mới Cache (Cache Warmer)" vertex="1">
          <mxGeometry height="125" width="590" x="515" y="425" as="geometry" />
        </mxCell>
        <mxCell id="mailpit" parent="tier2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FDEBD0;strokeColor=#AF601A;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;dashed=1;" value="&lt;b style=&quot;font-size:13.5px;&quot;&gt;Mailpit Container (Dev / QA SMTP Sink)&lt;/b&gt;&lt;br/&gt;• Bắt toàn bộ SMTP nội bộ cổng &lt;b&gt;:1025&lt;/b&gt; (Không cần xác thực)&lt;br/&gt;• Web UI kiểm thử Hóa đơn QR &amp;amp; Store Credit tại &lt;b&gt;localhost:8025&lt;/b&gt;" vertex="1">
          <mxGeometry height="125" width="540" x="1555" y="425" as="geometry" />
        </mxCell>
        <mxCell id="e_core_mailer" edge="1" parent="tier2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.522;entryY=0.003;entryDx=0;entryDy=0;strokeColor=#A93226;strokeWidth=3;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;entryPerimeter=0;" value="Email Trigger Hooks">
