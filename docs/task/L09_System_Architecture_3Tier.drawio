        <mxCell id="tier1" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;fillColor=#EBF5FB;strokeColor=#2E86C1;strokeWidth=2;swimlaneFillColor=#EBF5FB;rounded=1;" value="TIER 1 — PRESENTATION &amp; WEB PROXY TIER (Container: kleer-nginx | nginx:1.25-alpine)" vertex="1">
          <mxGeometry height="230" width="1790" x="85" y="335" as="geometry" />
        </mxCell>
        <mxCell id="nginx_proxy" parent="tier1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#AED6F1;strokeColor=#1B4F72;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Nginx Reverse Proxy (kleer-nginx)&lt;/b&gt;&lt;br/&gt;• Lắng nghe HTTP (80) &amp;amp; HTTPS (443, TLS 1.2/1.3, HSTS)&lt;br/&gt;• Redirect HTTP → HTTPS &amp;amp; nạp SSL (/etc/letsencrypt)&lt;br/&gt;• Phân luồng: Tĩnh (Static Files) vs Động (FastCGI PHP)" vertex="1">
          <mxGeometry height="155" width="420" x="35" y="50" as="geometry" />
        </mxCell>
        <mxCell id="nginx_static" parent="tier1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Static Assets &amp;amp; File Uploads&lt;/b&gt;&lt;br/&gt;• Volume: &lt;i&gt;./:/var/www/html:cached&lt;/i&gt;&lt;br/&gt;• Theme Assets: Ảnh .webp, CSS BEM, Vanilla JS&lt;br/&gt;• Plugin Assets: qrcode.min.js, kleer-qr.js" vertex="1">
          <mxGeometry height="155" width="380" x="525" y="50" as="geometry" />
        </mxCell>
        <mxCell id="nginx_fcgi" parent="tier1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FCF3CF;strokeColor=#B7950B;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;FastCGI Pass Gateway&lt;/b&gt;&lt;br/&gt;• Giao thức: FastCGI qua TCP (&lt;b&gt;php:9000&lt;/b&gt;)&lt;br/&gt;• Chuyển tiếp PHP, WooCommerce &amp;amp; REST API&lt;br/&gt;• Truyền Env Vars, Session &amp;amp; Nonce Headers" vertex="1">
          <mxGeometry height="155" width="380" x="965" y="50" as="geometry" />
        </mxCell>
        <mxCell id="certbot" parent="tier1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#E8DAEF;strokeColor=#7D3C98;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Certbot Container (Production)&lt;/b&gt;&lt;br/&gt;• Tự động gia hạn SSL Let&#39;s Encrypt&lt;br/&gt;• Chạy định kỳ mỗi 12h (&lt;i&gt;--webroot&lt;/i&gt;)&lt;br/&gt;• Shared Volumes: &lt;i&gt;letsencrypt, certbot_www&lt;/i&gt;" vertex="1">
          <mxGeometry height="155" width="355" x="1400" y="50" as="geometry" />
        </mxCell>
        <mxCell id="tier3" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;fillColor=#E8F8F5;strokeColor=#117864;strokeWidth=2;swimlaneFillColor=#E8F8F5;rounded=1;" value="TIER 3 — DATA &amp; CACHING TIER (Containers: kleer-mariadb [10.11] | kleer-redis [7-alpine] | kleer-phpmyadmin)" vertex="1">
          <mxGeometry height="270" width="2130" x="85" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="phpmyadmin" parent="tier3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#D5F5E3;strokeColor=#196F3D;strokeWidth=2;align=left;spacingLeft=14;lineHeight=1.35;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;phpMyAdmin Container&lt;/b&gt;&lt;br/&gt;(&lt;i&gt;kleer-phpmyadmin:8080&lt;/i&gt;)&lt;br/&gt;• Giao diện Web quản trị DB&lt;br/&gt;• Kiểm tra bảng HPOS &amp;amp; 3NF&lt;br/&gt;• Kết nối nội bộ qua TCP 3306" vertex="1">
          <mxGeometry height="195" width="330" x="35" y="50" as="geometry" />
