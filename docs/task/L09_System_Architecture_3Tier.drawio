        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A252F;" value="KLEER — Sơ đồ Kiến trúc Triển khai Vật lý 3 Tầng trên Docker Compose (3-Tier Deployment Architecture)" vertex="1">
