        <mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;fontColor=#34495E;" value="Kiến trúc Phân tầng Vật lý 3 Tầng (3-Tier Docker) kết hợp Microkernel / Plugin-based &amp; Layered OOP trên nền WordPress 6.x + WooCommerce 8.x (HPOS)" vertex="1">
