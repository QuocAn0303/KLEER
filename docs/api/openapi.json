{
  "openapi": "3.1.0",
  "info": {
    "title": "KLEER Routine API",
    "version": "0.2.0",
    "description": "Implementation contract prepared by Bui Hieu Nhan. Business G3 approval and successful catalog/performance acceptance are pending. See README.md for plain-permalink URLs, tags, fallback, integration and limits."
  },
  "servers": [
    {
      "url": "http://localhost:8081/wp-json/kleer/v1",
      "description": "Local example with pretty permalinks. Change host for your environment."
    }
  ],
  "paths": {
    "/recommend": {
      "post": {
        "summary": "Calculate a personalized routine from the five quiz answers",
        "description": "Public stateless endpoint. Default version v1 requires five known single-choice answers and policy_accepted=true. version=v4 preserves the upstream six-question draft and its missing_steps/warnings contract. Production uses real WooCommerce IDs; missing WooCommerce returns 503 for both versions. For v1, incomplete safe inventory also returns 503. Business rules await G3 approval.",
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "v1",
                "v4"
              ],
              "default": "v1"
            },
            "description": "v1: legacy five questions; v4: upstream six-question draft. Query parameter, never a JSON body property."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Omit for server clients, or use same-origin/approved CORS origin."
          },
          {
            "name": "X-WP-Nonce",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required for authenticated browser clients; checked whenever supplied. Action wp_rest."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizSubmission"
              },
              "example": {
                "session_id": "11111111-2222-4333-8444-555555555555",
                "consent": {
                  "policy_accepted": true,
                  "marketing_opt_in": false
                },
                "answers": [
                  {
                    "question_id": "q1_skin_feeling",
                    "answer": "greasy_all"
                  },
                  {
                    "question_id": "q2_pore_sebum",
                    "answer": "large_pores"
                  },
                  {
                    "question_id": "q3_sensitivity",
                    "answer": "rarely_never"
                  },
                  {
                    "question_id": "q4_main_concern",
                    "answer": "acne_blemish"
                  },
                  {
                    "question_id": "q5_routine_goal",
                    "answer": "intensive"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete ordered 3/4-step routine. Sensitive profile code is <primary_type>_sensitive; other profiles use <primary_type>_<concern>.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResponse"
                }
              }
            }
          },
          "400": {
            "description": "kleer_invalid_payload (schema/answers, with JSON Pointer), kleer_consent_required or kleer_invalid_version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "kleer_cors_forbidden or rest_cookie_invalid_nonce.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "kleer_woocommerce_unavailable, kleer_catalog_incomplete (missing_steps), or kleer_catalog_unavailable. Do not render a partial routine.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "kleer_quiz_engine_error. Generic message, no internal exception or database details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "recommendRoutine"
      }
    },
    "/skin-quiz": {
