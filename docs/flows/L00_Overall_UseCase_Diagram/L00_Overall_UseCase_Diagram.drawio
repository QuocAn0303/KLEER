        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;Khách vãng lai\\n(Guest)\&quot; as Guest\nactor \&quot;Thành viên\\n(Registered Customer)\&quot; as Member\nactor \&quot;Quản trị viên / Vận hành\\n(Admin / Warehouse / CSKH)\&quot; as Admin\n\nactor \&quot;Cổng thanh toán\\n(VNPay Sandbox / VietQR)\&quot; as PaymentGW &lt;&lt;System&gt;&gt;\nactor \&quot;Dịch vụ Email\\n(SMTP SendGrid/Gmail)\&quot; as EmailSvc &lt;&lt;System&gt;&gt;\nactor \&quot;Automation / REST Client\\n(Selenium / Python Script)\&quot; as AutoClient &lt;&lt;System&gt;&gt;\n\nMember --|&gt; Guest : Kế thừa quyền\n\nrectangle \&quot;Hệ thống TMĐT Mỹ phẩm Unisex KLEER (Tham chiếu nghiệp vụ Hasaki.vn)\&quot; {\n  \n  package \&quot;1. Phân hệ Tư vấn &amp; Khám phá Sản phẩm (L01, L02)\&quot; {\n    usecase \&quot;UC01: Làm Quiz chẩn đoán da &amp;\\nNhận Routine Unisex (L01)\&quot; as UC01\n    usecase \&quot;UC01.1: Kích hoạt Safe Fallback\\n(Gợi ý bộ dịu nhẹ)\&quot; as UC01_Fallback\n    usecase \&quot;UC02: Tìm kiếm &amp; Lọc sản phẩm\\nđa tiêu chí Ajax (L02)\&quot; as UC02\n    usecase \&quot;UC03: Xem chi tiết sản phẩm,\\nThành phần &amp; Bước Routine (L02)\&quot; as UC03\n  }\n\n  package \&quot;2. Phân hệ Giỏ hàng, Combo &amp; Thanh toán (L03, L04)\&quot; {\n    usecase \&quot;UC04: Quản lý giỏ hàng &amp;\\nThêm 1-Click Routine (L03)\&quot; as UC04\n    usecase \&quot;UC04.1: Tự động giảm 15%\\nCombo Routine (3-4 bước)\&quot; as UC04_Discount\n    usecase \&quot;UC04.2: Cảnh báo xung đột\\nhoạt chất (AHA/BHA vs Retinol)\&quot; as UC04_Conflict\n    usecase \&quot;UC05: Đặt hàng &amp; Thanh toán\\n(COD, VietQR, VNPay) (L04)\&quot; as UC05\n    usecase \&quot;UC05.1: Tính phí vận chuyển\\n(Freeship &gt;= 500k) (L06)\&quot; as UC05_Ship\n    usecase \&quot;UC05.2: Xác thực chữ ký SHA512 &amp;\\nXử lý IPN Callback\&quot; as UC05_VNPay\n  }\n\n  package \&quot;3. Phân hệ Tài khoản &amp; Hậu mãi (L05, L07)\&quot; {\n    usecase \&quot;UC06: Đăng ký, Đăng nhập &amp;\\nLưu hồ sơ da cá nhân\&quot; as UC06\n    usecase \&quot;UC07: Tra cứu hành trình đơn hàng &amp;\\nYêu cầu Đổi trả 7 ngày (L06, L07)\&quot; as UC07\n  }\n\n  package \&quot;4. Phân hệ Quản trị, Kho HPOS &amp; Tự động hóa (L05, L08, L10)\&quot; {\n    usecase \&quot;UC08: Quản trị vòng đời đơn hàng HPOS,\\nXuất kho &amp; Gửi hóa đơn QR (L05, L06)\&quot; as UC08\n    usecase \&quot;UC09: Thẩm định Đổi trả, Hoàn tiền &amp;\\nNhập lại kho (Restock) (L07)\&quot; as UC09\n    usecase \&quot;UC10: Đồng bộ &gt;= 500 SKU &amp;\\nQuản lý 3 Custom Taxonomies (L08)\&quot; as UC10\n    usecase \&quot;UC11: Thực thi 3 tác vụ tự động qua\\nREST API v3 &amp; Selenium (L10)\&quot; as UC11\n  }\n}\n\n&#39; Kết nối Actor với Use Case\nGuest --&gt; UC01\nGuest --&gt; UC02\nGuest --&gt; UC03\nGuest --&gt; UC04\nGuest --&gt; UC05\nGuest --&gt; UC06\n\nMember --&gt; UC07\n\nAdmin --&gt; UC08\nAdmin --&gt; UC09\nAdmin --&gt; UC10\nAdmin --&gt; UC11\n\n&#39; Quan hệ Include / Extend\nUC01 &lt;.. UC01_Fallback : &lt;&lt;extend&gt;&gt;\\n(Khi không khớp 100%)\nUC04 ..&gt; UC04_Discount : &lt;&lt;include&gt;&gt;\nUC04 &lt;.. UC04_Conflict : &lt;&lt;extend&gt;&gt;\\n(Khi có chất kỵ nhau)\nUC05 ..&gt; UC05_Ship : &lt;&lt;include&gt;&gt;\nUC05 &lt;.. UC05_VNPay : &lt;&lt;extend&gt;&gt;\\n(Khi chọn VNPay)\nUC07 ..&gt; UC09 : &lt;&lt;include&gt;&gt;\\n(Luồng xử lý đổi trả)\n\n&#39; Kết nối Hệ thống ngoài\nUC05_VNPay --&gt; PaymentGW\nUC08 --&gt; EmailSvc\nAutoClient --&gt; UC11\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4mW4wtIipF6l8Qx8NwrF-1">
