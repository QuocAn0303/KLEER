xCell><mxCell id="c64" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="76" y="1506" width="1258" height="292" as="geometry"/></mxCell><mxCell id="c65" value="alt  ResponseCode=00 và TransactionStatus=00" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="1508" width="380" height="22" as="geometry"/></mxCell><mxCell id="c66" value="16. {RspCode:00, Confirm Success} → VNPay dừng retry" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1808" as="sourcePoint"/><mxPoint x="1240" y="1808" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="68" y="1236" width="1274" height="622" as="geometry"/></mxCell><mxCell id="c68" value="alt  Không thấy đơn" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="72" y="1238" width="380" height="22" as="geometry"/></mxCell><mxCell id="c69" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="1076" width="1290" height="796" as="geometry"/></mxCell><mxCell id="c70" value="alt  Checksum sai" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="64" y="1078" width="380" height="22" as="geometry"/></mxCell><mxCell id="c71" value="D. Return URL (trình duyệt): chỉ hiển thị, KHÔNG ghi nhận thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1884" width="1330" height="26" as="geometry"/></mxCell><mxCell id="c72" value="17. HTTP 302 → vnp_ReturnUrl?vnp_*&amp;vnp_SecureHash" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="1930" as="sourcePoint"/><mxPoint x="120" y="1930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c73" value="18. GET return URL" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="1976" as="sourcePoint"/><mxPoint x="680" y="1976" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c74" value="19. Verify lại checksum SHA512" style="endArrow=block;endFill=1;html=1;align=left;labelPosition=right;verticalLabelPosition=middle;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2022" as="sourcePoint"/><mxPoint x="680" y="2050" as="targetPoint"/><Array as="points"><mxPoint x="740" y="2022"/><mxPoint x="740" y="2050"/></Array></mxGeometry></mxCell><mxCell id="c75" value="20. Đọc trạng thái đơn hiện tại (read-only)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2078" as="sourcePoint"/><mxPoint x="960" y="2078" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" value="Trang cảm ơn / order-received" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2160" as="sourcePoint"/><mxPoint x="120" y="2160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="2208" as="sourcePoint"/><mxPoint x="1350" y="2208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c78" value="else  Cancelled" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="64" y="2209" width="460" height="20" as="geometry"/></mxCell><mxCell id="c79" value="Thông báo đã hủy + nút Thanh toán lại" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2238" as="sourcePoint"/><mxPoint x="120" y="2238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c80" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="2286" as="sourcePoint"/><mxPoint x="1350" y="2286" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c81" value="else  Failed / Pending / checksum sai" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="64" y="2287" width="460" height="20" as="geometry"/></mxCell><mxCell id="c82" value="Thông báo lỗi / đang chờ xác nhận (IPN có thể đến sau)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2316" as="sourcePoint"/><mxPoint x="120" y="2316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="2130" width="1290" height="236" as="geometry"/></mxCell><mxCell id="c84" value="alt  Processing" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="64" y="2132" width="380" height="22" as="geometry"/></mxCell><mxCell id="c85" value="Ghi chú: (1) Chỉ IPN được cập nhật trạng thái đơn; ReturnUrl chỉ hiển thị. (2) RspCode 00/02 → VNPay dừng; 01/04/97/99 hoặc timeout → VNPay retry. (3) vnp_Amount = VND × 100. (4) HashSecret lưu trong .env, không commit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2416" width="1330" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>