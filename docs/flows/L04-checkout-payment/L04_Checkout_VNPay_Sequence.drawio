height="50" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="140" as="sourcePoint"/><mxPoint x="960" y="2406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="VNPay Sandbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1145" y="90" width="190" height="50" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="140" as="sourcePoint"/><mxPoint x="1240" y="2406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="Sequence Diagram – Thanh toán VNPay Sandbox (L04-G2-01, KLEER)" style="text;html=1;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="c22" value="A. Tạo đơn &amp; dựng URL thanh toán (ký SHA512)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="1330" height="26" as="geometry"/></mxCell><mxCell id="c23" value="1. Chọn VNPay, bấm Đặt hàng" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="208" as="sourcePoint"/><mxPoint x="400" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="2. Tạo đơn: Pending payment (vnp_TxnRef = order_id)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="254" as="sourcePoint"/><mxPoint x="960" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="3. process_payment(order)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="300" as="sourcePoint"/><mxPoint x="680" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="4. Dựng vnp_*: bỏ tham số rỗng, sort a→z, urlencode" style="endArrow=block;endFill=1;html=1;align=left;labelPosition=right;verticalLabelPosition=middle;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="346" as="sourcePoint"/><mxPoint x="680" y="374" as="targetPoint"/><Array as="points"><mxPoint x="740" y="346"/><mxPoint x="740" y="374"/></Array></mxGeometry></mxCell><mxCell id="c27" value="5. vnp_SecureHash = HMAC-SHA512(query, vnp_HashSecret)" style="endArrow=block;endFill=1;html=1;align=left;labelPosition=right;verticalLabelPosition=middle;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="402" as="sourcePoint"/><mxPoint x="680" y="430" as="targetPoint"/><Array as="points"><mxPoint x="740" y="402"/><mxPoint x="740" y="430"/></Array></mxGeometry></mxCell><mxCell id="c28" value="6. payment_url (…vpcpay.html?vnp_*&amp;vnp_SecureHash)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="458" as="sourcePoint"/><mxPoint x="400" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="7. HTTP 302 → payment_url" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="504" as="sourcePoint"/><mxPoint x="120" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="B. Redirect sang VNPay Sandbox &amp; thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="1330" height="26" as="geometry"/></mxCell><mxCell id="c31" value="8. GET vpcpay.html?vnp_*" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="598" as="sourcePoint"/><mxPoint x="1240" y="598" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="9. Kiểm tra checksum, TmnCode, số tiền" style="endArrow=block;endFill=1;html=1;align=left;labelPosition=right;verticalLabelPosition=middle;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="644" as="sourcePoint"/><mxPoint x="1240" y="672" as="targetPoint"/><Array as="points"><mxPoint x="1300" y="644"/><mxPoint x="1300" y="672"/></Array></mxGeometry></mxCell><mxCell id="c33" value="Trang lỗi (mã 97 – Chữ ký không hợp lệ)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="736" as="sourcePoint"/><mxPoint x="120" y="736" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="784" as="sourcePoint"/><mxPoint x="1350" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="else  Hợp lệ" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="64" y="785" width="460" height="20" as="geometry"/></mxCell><mxCell id="c36" value="10. Hiển thị cổng: chọn NCB / thẻ, nhập OTP" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="814" as="sourcePoint"/><mxPoint x="120" y="814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="11. Nhập thẻ test + OTP 123456 (hoặc bấm Hủy)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="860" as="sourcePoint"/><mxPoint x="1240" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="706" width="1290" height="204" as="geometry"/></mxCell><mxCell id="c39" value="alt  Tham số / chữ ký sai" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="64" y="708" width="380" height="22" as="geometry"/></mxCell><mxCell id="c40" value="C. IPN callback (server → server): NGUỒN DUY NHẤT cập nhật trạng thái đơn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="922" width="1330" height="26" as="geometry"/></mxCell><mxCell id="c41" value="12. GET IPN ?vnp_*&amp;vnp_SecureHash" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="968" as="sourcePoint"/><mxPoint x="680" y="968" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="13. Tính lại HMAC-SHA512 (bỏ vnp_SecureHash, sort a→z), so sánh" style="endArrow=block;endFill=1;html=1;align=left;labelPosition=right;verticalLabelPosition=middle;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1014" as="sourcePoint"/><mxPoint x="680" y="1042" as="targetPoint"/><Array as="points"><mxPoint x="740" y="1014"/><mxPoint x="740" y="1042"/></Array></mxGeometry></mxCell><mxCell id="c43" value="{RspCode:97, Invalid signature} → VNPay retry" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1106" as="sourcePoint"/><mxPoint x="1240" y="1106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1154" as="sourcePoint"/><mxPoint x="1350" y="1154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="else  Checksum đúng" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="64" y="1155" width="460" height="20" as="geometry"/></mxCell><mxCell id="c46" value="14. Tìm đơn theo vnp_TxnRef" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1184" as="sourcePoint"/><mxPoint x="960" y="1184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="{RspCode:01, Order not found} → retry" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1266" as="sourcePoint"/><mxPoint x="1240" y="1266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="68" y="1314" as="sourcePoint"/><mxPoint x="1342" y="1314" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="else  vnp_Amount/100 ≠ tổng đơn" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="72" y="1315" width="460" height="20" as="geometry"/></mxCell><mxCell id="c50" value="{RspCode:04, invalid amount} → retry" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1344" as="sourcePoint"/><mxPoint x="1240" y="1344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="68" y="1392" as="sourcePoint"/><mxPoint x="1342" y="1392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="else  Đơn không còn Pending payment (IPN lặp)" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="72" y="1393" width="460" height="20" as="geometry"/></mxCell><mxCell id="c53" value="{RspCode:02, Order already confirmed} → dừng" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1422" as="sourcePoint"/><mxPoint x="1240" y="1422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="68" y="1470" as="sourcePoint"/><mxPoint x="1342" y="1470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="else  Đơn Pending payment, số tiền khớp" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="72" y="1471" width="460" height="20" as="geometry"/></mxCell><mxCell id="c56" value="15a. payment_complete(): Pending → PROCESSING (Đang xử lý)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1536" as="sourcePoint"/><mxPoint x="960" y="1536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="Trừ kho, gửi email hóa đơn (L05)" style="endArrow=block;endFi