        <mxCell id="db_hpos" value="&lt;b style=&quot;font-size:12.5px;&quot;&gt;MariaDB — WooCommerce HPOS &amp;amp; Coupons&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;wp_wc_orders, order_addresses, operational_data, orders_meta&lt;/i&gt;&lt;br/&gt;• &lt;i&gt;wp_woocommerce_order_items&lt;/i&gt; &amp;amp; &lt;i&gt;wp_posts (shop_coupon)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11.5;fillColor=#CFD8DC;strokeColor=#37474F;strokeWidth=1.5;align=left;spacingLeft=12;lineHeight=1.3;" vertex="1" parent="layer6">
