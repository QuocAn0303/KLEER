        <!-- ================= LAYER 2: PHYSICAL HPOS & WORDPRESS SCHEMA MAPPING ================= -->
        <mxCell id="layer2" value="TẦNG 2 — ÁNH XẠ VẬT LÝ SANG KIẾN TRÚC BẢNG PHẲNG WOOCOMMERCE HPOS &amp; WORDPRESS TAXONOMY SCHEMA (MariaDB 10.11 + Redis)" style="swimlane;whiteSpace=wrap;html=1;startSize=38;fontStyle=1;fontSize=15;fontColor=#FFFFFF;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=2;swimlaneFillColor=#F0F7FF;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1045" width="2520" height="460" as="geometry" />
        </mxCell>

        <mxCell id="layer2_sub" value="&lt;b style=&quot;color:#0D47A1;&quot;&gt;Cơ chế Ánh xạ Vật lý (Physical Schema Mapping — Mục 4.2.2):&lt;/b&gt; Giải quyết triệt để điểm nghẽn hiệu năng của bảng &lt;code&gt;wp_postmeta&lt;/code&gt; truyền thống bằng cách tách đơn hàng sang hệ thống 4 bảng phẳng &lt;b&gt;WooCommerce HPOS&lt;/b&gt; (&lt;code&gt;HposService.php&lt;/code&gt;), đánh chỉ mục bảng tra cứu sản phẩm (&lt;code&gt;wp_wc_product_meta_lookup&lt;/code&gt;) và đệm truy vấn qua &lt;b&gt;Redis In-Memory Cache&lt;/b&gt; (&lt;code&gt;KleerCache&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="layer2">
          <mxGeometry x="40" y="50" width="2440" height="42" as="geometry" />
        </mxCell>

        <!-- Row 1 of Layer 2: 3 Cards -->
        <!-- Card 1: Users -->
        <mxCell id="map1" value="1. ÁNH XẠ BẢNG Users" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#1E40AF;strokeColor=#1E3A8A;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="40" y="110" width="580" height="150" as="geometry" />
        </mxCell>
        <mxCell id="map1_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;• Bảng Luận lý 3NF:&lt;/b&gt; &lt;code&gt;Users&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;• Bảng Vật lý MariaDB:&lt;/b&gt; &lt;code&gt;wp_users&lt;/code&gt; &amp;amp; &lt;code&gt;wp_usermeta&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Cơ chế lưu trữ &amp;amp; Lợi ích hiệu năng:&lt;/b&gt;&lt;br&gt;Lưu thông tin định danh tài khoản (&lt;code&gt;ID, user_email, user_pass&lt;/code&gt; băm bảo mật) trong &lt;code&gt;wp_users&lt;/code&gt;; lưu họ tên, số điện thoại giao hàng và phân quyền vai trò (&lt;code&gt;customer / admin&lt;/code&gt;) trong &lt;code&gt;wp_usermeta&lt;/code&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map1">
          <mxGeometry x="0" y="30" width="580" height="120" as="geometry" />
        </mxCell>

        <!-- Card 2: Products -->
        <mxCell id="map2" value="2. ÁNH XẠ BẢNG Products (≥ 500 SKU)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#047857;strokeColor=#065F46;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="650" y="110" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="map2_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;• Bảng Luận lý 3NF:&lt;/b&gt; &lt;code&gt;Products&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;• Bảng Vật lý MariaDB:&lt;/b&gt; &lt;code&gt;wp_posts (post_type='product')&lt;/code&gt; &amp;amp; &lt;b&gt;&lt;code&gt;wp_wc_product_meta_lookup&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Cơ chế lưu trữ &amp;amp; Lợi ích hiệu năng:&lt;/b&gt;&lt;br&gt;Sử dụng bảng phẳng &lt;code&gt;wp_wc_product_meta_lookup&lt;/code&gt; đánh chỉ mục (Index) trực tiếp cho &lt;code&gt;sku, min_price, max_price, stock_status, stock_quantity&lt;/code&gt; giúp lọc AJAX &amp;amp; chấm điểm Quiz cực nhanh mà không cần JOIN nhiều lần vào &lt;code&gt;wp_postmeta&lt;/code&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map2">
          <mxGeometry x="0" y="30" width="610" height="120" as="geometry" />
        </mxCell>

        <!-- Card 3: Taxonomy_Terms & Product_Taxonomies -->
        <mxCell id="map3" value="3. ÁNH XẠ Taxonomy_Terms &amp; Product_Taxonomies" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#047857;strokeColor=#065F46;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="1290" y="110" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="map3_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;• Bảng Luận lý 3NF:&lt;/b&gt; &lt;code&gt;Taxonomy_Terms&lt;/code&gt; &amp;amp; &lt;code&gt;Product_Taxonomies&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;• Bảng Vật lý MariaDB:&lt;/b&gt; &lt;code&gt;wp_terms&lt;/code&gt;, &lt;code&gt;wp_term_taxonomy&lt;/code&gt;, &lt;code&gt;wp_term_relationships&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Cơ chế lưu trữ &amp;amp; Lợi ích hiệu năng:&lt;/b&gt;&lt;br&gt;Hệ thống 3 bảng quan hệ chuẩn hóa của WordPress lưu toàn bộ 4 trục thuộc tính da liễu (&lt;code&gt;pa_skin_type, pa_skin_concern, pa_routine_step, pa_active_ingredient&lt;/code&gt;), đánh Index phức hợp trên &lt;code&gt;(object_id, term_taxonomy_id)&lt;/code&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map3">
          <mxGeometry x="0" y="30" width="610" height="120" as="geometry" />
        </mxCell>

        <!-- Card 4 (Top Right): Redis In-Memory Cache -->
        <mxCell id="map_redis" value="7. TẦNG ĐỆM REDIS IN-MEMORY CACHE (KleerCache)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#B91C1C;strokeColor=#991B1B;strokeWidth=1.5;swimlaneFillColor=#FFFBEB;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="1930" y="110" width="550" height="150" as="geometry" />
        </mxCell>
        <mxCell id="map_redis_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#B91C1C;&quot;&gt;• Container vật lý:&lt;/b&gt; &lt;code&gt;redis:alpine&lt;/code&gt; (Tầng 3 Data &amp;amp; Caching Tier)&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;• Nhóm khóa đệm (Cache Groups):&lt;/b&gt; &lt;code&gt;kleer_products&lt;/code&gt;, &lt;code&gt;kleer_quiz&lt;/code&gt;, &lt;code&gt;kleer_api&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Cơ chế vận hành &amp;amp; Lợi ích hiệu năng:&lt;/b&gt;&lt;br&gt;Đệm kết quả truy vấn danh mục sản phẩm, từ điển Taxonomy INCI và kết quả chấm điểm Routine v4 trên RAM; tự động xóa cache (Cache Invalidation) khi cập nhật tồn kho HPOS, giảm tải truy vấn SQL xuống đĩa cứng.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map_redis">
          <mxGeometry x="0" y="30" width="550" height="120" as="geometry" />
        </mxCell>

        <!-- Row 2 of Layer 2: 3 Cards -->
        <!-- Card 5: Orders & Payment_Transactions (HPOS Core) -->
        <mxCell id="map4" value="4. ÁNH XẠ Orders &amp; Payment_Transactions → KIẾN TRÚC BẢNG PHẲNG WOOCOMMERCE HPOS CHUYÊN BIỆT" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#1D4ED8;strokeColor=#1E3A8A;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="40" y="280" width="1220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="map4_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;• Bảng Luận lý 3NF:&lt;/b&gt; &lt;code&gt;Orders&lt;/code&gt; &amp;amp; &lt;code&gt;Payment_Transactions&lt;/code&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#047857;&quot;&gt;• 4 Bảng Vật lý HPOS MariaDB:&lt;/b&gt; &lt;b&gt;&lt;code&gt;wp_wc_orders&lt;/code&gt;&lt;/b&gt;, &lt;b&gt;&lt;code&gt;wp_wc_order_addresses&lt;/code&gt;&lt;/b&gt;, &lt;b&gt;&lt;code&gt;wp_wc_order_operational_data&lt;/code&gt;&lt;/b&gt;, &lt;b&gt;&lt;code&gt;wp_wc_orders_meta&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Phân tách lưu trữ HPOS (&lt;code&gt;HposService.php&lt;/code&gt;):&lt;/b&gt; Tách hoàn toàn dữ liệu đơn hàng ra khỏi bảng bài viết &lt;code&gt;wp_posts&lt;/code&gt; để tăng tốc độ xử lý giao dịch đồng thời:&lt;br&gt;1. &lt;b&gt;&lt;code&gt;wp_wc_orders&lt;/code&gt;:&lt;/b&gt; Lưu phẳng các trường cốt lõi có đánh Index (&lt;code&gt;id, status, total_amount, customer_id, billing_email, payment_method, transaction_id, date_created_gmt&lt;/code&gt;).&lt;br&gt;2. &lt;b&gt;&lt;code&gt;wp_wc_order_addresses&lt;/code&gt;:&lt;/b&gt; Lưu tách biệt địa chỉ &lt;code&gt;billing&lt;/code&gt; và &lt;code&gt;shipping&lt;/code&gt; có đánh chỉ mục tìm kiếm nhanh theo khách hàng.&lt;br&gt;3. &lt;b&gt;&lt;code&gt;wp_wc_order_operational_data&lt;/code&gt; &amp;amp; &lt;code&gt;wp_wc_orders_meta&lt;/code&gt;:&lt;/b&gt; Lưu cờ vận hành, &lt;code&gt;_kleer_return_reason&lt;/code&gt;, &lt;code&gt;_kleer_return_tracking_code&lt;/code&gt; và trạng thái xác thực chữ ký &lt;code&gt;HMAC-SHA512&lt;/code&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map4">
          <mxGeometry x="0" y="30" width="1220" height="125" as="geometry" />
        </mxCell>

        <!-- Card 6: Order_Items -->
        <mxCell id="map5" value="5. ÁNH XẠ BẢNG Order_Items (Chi tiết đơn &amp; Phí Combo)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#0D9488;strokeColor=#0F766E;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="1290" y="280" width="610" height="155" as="geometry" />
        </mxCell>
        <mxCell id="map5_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;• Bảng Luận lý 3NF:&lt;/b&gt; &lt;code&gt;Order_Items&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;• Bảng Vật lý MariaDB:&lt;/b&gt; &lt;code&gt;wp_woocommerce_order_items&lt;/code&gt; &amp;amp; &lt;code&gt;wp_wc_order_product_lookup&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Cơ chế lưu trữ &amp;amp; Lợi ích hiệu năng:&lt;/b&gt;&lt;br&gt;Lưu chi tiết từng dòng sản phẩm (&lt;code&gt;order_item_type = 'line_item'&lt;/code&gt;) và khoản chiết khấu tự động &lt;b&gt;Giảm 15% Combo Routine&lt;/b&gt; (&lt;code&gt;order_item_type = 'fee'&lt;/code&gt;); bảng phẳng &lt;code&gt;wp_wc_order_product_lookup&lt;/code&gt; hỗ trợ thống kê doanh thu/sản lượng theo SKU tức thì.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map5">
          <mxGeometry x="0" y="30" width="610" height="125" as="geometry" />
        </mxCell>

        <!-- Card 7: Store_Credits -->
        <mxCell id="map6" value="6. ÁNH XẠ BẢNG Store_Credits (Instant Refund Coupon)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=12.5;fontColor=#FFFFFF;fillColor=#6D28D9;strokeColor=#5B21B6;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="layer2">
          <mxGeometry x="1930" y="280" width="550" height="155" as="geometry" />
        </mxCell>
        <mxCell id="map6_body" value="&lt;div style=&quot;line-height:1.45;font-size:12px;color:#1F2937;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;• Bảng Luận lý 3NF:&lt;/b&gt; &lt;code&gt;Store_Credits&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;• Bảng Vật lý MariaDB:&lt;/b&gt; &lt;code&gt;wp_posts (post_type='shop_coupon')&lt;/code&gt; &amp;amp; &lt;code&gt;wp_postmeta&lt;/code&gt;&lt;br&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;• Cơ chế lưu trữ &amp;amp; Lợi ích hiệu năng:&lt;/b&gt;&lt;br&gt;Lưu mã Store Credit (&lt;code&gt;KLR-CREDIT-{ORDER_ID}-{HASH}&lt;/code&gt;) với &lt;code&gt;discount_type = 'fixed_cart'&lt;/code&gt;, &lt;code&gt;coupon_amount&lt;/code&gt;, giới hạn theo &lt;code&gt;customer_email&lt;/code&gt; và &lt;code&gt;usage_limit = 1&lt;/code&gt;, tương thích 100% với bộ tính tiền tại trang Checkout của WooCommerce.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="map6">
          <mxGeometry x="0" y="30" width="550" height="125" as="geometry" />
        </mxCell>


        <!-- ================= LAYER 3: NORMALIZATION PROOF (1NF - 2NF - 3NF) ================= -->
        <mxCell id="norm_layer" value="GIẢI TRÌNH TÍNH CHUẨN HÓA CƠ SỞ DỮ LIỆU QUAN HỆ (DATABASE NORMALIZATION: 1NF — 2NF — 3NF)" style="swimlane;whiteSpace=wrap;html=1;startSize=38;fontStyle=1;fontSize=15;fontColor=#FFFFFF;fillColor=#C2410C;strokeColor=#9A3412;strokeWidth=2;swimlaneFillColor=#FFF7ED;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1530" width="2520" height="290" as="geometry" />
        </mxCell>

        <!-- 1NF Card -->
        <mxCell id="norm1" value="ĐẠT CHUẨN 1NF (FIRST NORMAL FORM — GIÁ TRỊ NGUYÊN TỐ / ATOMICITY)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#D97706;strokeColor=#B45309;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="norm_layer">
          <mxGeometry x="40" y="55" width="780" height="210" as="geometry" />
        </mxCell>
        <mxCell id="norm1_body" value="&lt;div style=&quot;line-height:1.5;font-size:12.5px;color:#1F2937;&quot;&gt;• &lt;b style=&quot;color:#B45309;&quot;&gt;Nguyên tắc chuẩn 1NF:&lt;/b&gt; Mọi thuộc tính trong cả 8 bảng quan hệ đều chỉ chứa &lt;b&gt;giá trị đơn / nguyên tố (Atomic Value)&lt;/b&gt;, không có nhóm lặp (Repeating Groups) và không lưu mảng phân cách bằng dấu phẩy.&lt;br&gt;• &lt;b style=&quot;color:#047857;&quot;&gt;Áp dụng thực tế trong KLEER:&lt;/b&gt;&lt;br&gt;+ Một sản phẩm chăm sóc da có thể phù hợp với nhiều &lt;i&gt;Loại da&lt;/i&gt; (&lt;code&gt;pa_skin_type&lt;/code&gt;), giải quyết nhiều &lt;i&gt;Vấn đề da&lt;/i&gt; (&lt;code&gt;pa_skin_concern&lt;/code&gt;) và chứa nhiều &lt;i&gt;Hoạt chất chính&lt;/i&gt; (&lt;code&gt;pa_active_ingredient&lt;/code&gt;).&lt;br&gt;+ Thay vì lưu chuỗi đa trị trong bảng &lt;code&gt;Products&lt;/code&gt;, hệ thống tách hoàn toàn ra bảng liên kết trung gian &lt;b&gt;&lt;code&gt;Product_Taxonomies(product_id, term_id)&lt;/code&gt;&lt;/b&gt; và bảng &lt;b&gt;&lt;code&gt;Order_Items&lt;/code&gt;&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="norm1">
          <mxGeometry x="0" y="32" width="780" height="178" as="geometry" />
        </mxCell>

        <!-- 2NF Card -->
        <mxCell id="norm2" value="ĐẠT CHUẨN 2NF (SECOND NORMAL FORM — PHỤ THUỘC HÀM ĐẦY ĐỦ)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#EA580C;strokeColor=#C2410C;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="norm_layer">
          <mxGeometry x="870" y="55" width="780" height="210" as="geometry" />
        </mxCell>
        <mxCell id="norm2_body" value="&lt;div style=&quot;line-height:1.5;font-size:12.5px;color:#1F2937;&quot;&gt;• &lt;b style=&quot;color:#C2410C;&quot;&gt;Nguyên tắc chuẩn 2NF:&lt;/b&gt; Đã đạt 1NF và mọi thuộc tính không khóa (Non-key attributes) trong các bảng có khóa chính ghép phải &lt;b&gt;phụ thuộc hàm đầy đủ (Full Functional Dependency)&lt;/b&gt; vào toàn bộ khóa chính, không phụ thuộc bộ phận.&lt;br&gt;• &lt;b style=&quot;color:#047857;&quot;&gt;Áp dụng thực tế trong KLEER:&lt;/b&gt;&lt;br&gt;+ Trong bảng &lt;b&gt;&lt;code&gt;Order_Items&lt;/code&gt;&lt;/b&gt;, các thuộc tính &lt;code&gt;quantity&lt;/code&gt;, &lt;code&gt;unit_price&lt;/code&gt; và &lt;code&gt;line_total&lt;/code&gt; phụ thuộc đồng thời vào cả &lt;code&gt;order_id&lt;/code&gt; lẫn &lt;code&gt;product_id&lt;/code&gt;.&lt;br&gt;+ Các thuộc tính chỉ phụ thuộc vào riêng mã sản phẩm như &lt;code&gt;product_name&lt;/code&gt;, &lt;code&gt;sku&lt;/code&gt;, &lt;code&gt;regular_price&lt;/code&gt; gốc hay &lt;code&gt;full_inci_list&lt;/code&gt; đã được tách triệt để về bảng &lt;b&gt;&lt;code&gt;Products&lt;/code&gt;&lt;/b&gt;; tên thuộc tính &lt;code&gt;term_name&lt;/code&gt; được tách về bảng &lt;b&gt;&lt;code&gt;Taxonomy_Terms&lt;/code&gt;&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="norm2">
          <mxGeometry x="0" y="32" width="780" height="178" as="geometry" />
        </mxCell>

        <!-- 3NF Card -->
        <mxCell id="norm3" value="ĐẠT CHUẨN 3NF (THIRD NORMAL FORM — TRIỆT TIÊU PHỤ THUỘC BẮC CẦU)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#C2410C;strokeColor=#9A3412;strokeWidth=1.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="norm_layer">
          <mxGeometry x="1700" y="55" width="780" height="210" as="geometry" />
        </mxCell>
        <mxCell id="norm3_body" value="&lt;div style=&quot;line-height:1.5;font-size:12.5px;color:#1F2937;&quot;&gt;• &lt;b style=&quot;color:#9A3412;&quot;&gt;Nguyên tắc chuẩn 3NF:&lt;/b&gt; Đã đạt 2NF và &lt;b&gt;không tồn tại phụ thuộc bắc cầu (No Transitive Dependency)&lt;/b&gt; giữa các thuộc tính không khóa (&lt;code&gt;A → B → C&lt;/code&gt;).&lt;br&gt;• &lt;b style=&quot;color:#047857;&quot;&gt;Áp dụng thực tế trong KLEER:&lt;/b&gt;&lt;br&gt;+ Hồ sơ định danh khách hàng (&lt;code&gt;full_name, password_hash, phone, role&lt;/code&gt;) tách riêng ở bảng &lt;b&gt;&lt;code&gt;Users&lt;/code&gt;&lt;/b&gt;, bảng &lt;code&gt;Orders&lt;/code&gt; chỉ tham chiếu qua khóa ngoại &lt;code&gt;customer_id&lt;/code&gt;.&lt;br&gt;+ Chi tiết đối soát cổng thanh toán (&lt;code&gt;gateway_txn_ref, signature_verified, paid_at&lt;/code&gt;) tách sang bảng &lt;b&gt;&lt;code&gt;Payment_Transactions&lt;/code&gt;&lt;/b&gt;; thông tin vòng đời mã hoàn tiền nhanh tách sang bảng &lt;b&gt;&lt;code&gt;Store_Credits&lt;/code&gt;&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="norm3">
          <mxGeometry x="0" y="32" width="780" height="178" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
