  <diagram name="L09 - Database ERD 3NF and HPOS" id="L09-ERD-HPOS">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1860" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= HEADER BANNER ================= -->
        <mxCell id="header_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1E3A2F;strokeColor=#0F291E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="title" value="KLEER — SƠ ĐỒ ERD CƠ SỞ DỮ LIỆU QUAN HỆ CHUẨN HÓA 3NF &amp; ÁNH XẠ VẬT LÝ WOOCOMMERCE HPOS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="26" width="2480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Mục 4.2 Thiết kế Cơ sở dữ liệu (EC312)  |  Tầng 1: Mô hình Quan hệ Luận lý Chuẩn hóa 3NF (8 Thực thể)   •   Tầng 2: Ánh xạ Vật lý sang Kiến trúc Bảng phẳng WooCommerce HPOS &amp; WordPress Schema (MariaDB 10.11 + Redis)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#D1FAE5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="2480" height="28" as="geometry" />
        </mxCell>

        <!-- ================= LAYER 1: LOGICAL 3NF SCHEMA ================= -->
        <mxCell id="layer1" value="TẦNG 1 — MÔ HÌNH DỮ LIỆU QUAN HỆ LUẬN LÝ CHUẨN HÓA 3NF (LOGICAL 3NF ERD — 8 THỰC THỂ CỐT LÕI)" style="swimlane;whiteSpace=wrap;html=1;startSize=38;fontStyle=1;fontSize=15;fontColor=#FFFFFF;fillColor=#1B5E20;strokeColor=#1B5E20;strokeWidth=2;swimlaneFillColor=#F4FAF6;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="2520" height="900" as="geometry" />
        </mxCell>

        <!-- Legend Box inside Layer 1 (Top Right) -->
        <mxCell id="legend_box" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;&lt;b style=&quot;color:#1B5E20;font-size:13px;&quot;&gt;CHÚ GIẢI KÝ HIỆU SƠ ĐỒ ERD (CROW'S FOOT NOTATION)&lt;/b&gt;&lt;hr style=&quot;border-color:#A7F3D0;margin:4px 0;&quot;&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;[PK]&lt;/b&gt; Primary Key (Khóa chính) &amp;nbsp;|&amp;nbsp; &lt;b style=&quot;color:#1D4ED8;&quot;&gt;[FK]&lt;/b&gt; Foreign Key (Khóa ngoại) &amp;nbsp;|&amp;nbsp; &lt;b style=&quot;color:#047857;&quot;&gt;[PK, FK]&lt;/b&gt; Khóa chính ghép (Bảng trung gian M-N) &amp;nbsp;|&amp;nbsp; &lt;b style=&quot;color:#6D28D9;&quot;&gt;UQ&lt;/b&gt; Unique &amp;nbsp;|&amp;nbsp; &lt;b&gt;AI&lt;/b&gt; Auto Increment&lt;br&gt;&lt;b style=&quot;color:#1B5E20;&quot;&gt;──||──────|&amp;lt;&lt;/b&gt; Quan hệ 1 - Nhiều bắt buộc (1 : N) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#1565C0;&quot;&gt;──o|──────|&amp;lt;&lt;/b&gt; Quan hệ 0..1 - Nhiều tùy chọn (Guest Checkout) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#6A1B9A;&quot;&gt;──||──────o|&lt;/b&gt; Quan hệ 1 - 0..1 (Giao dịch / Hoàn tiền)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;" vertex="1" parent="layer1">
          <mxGeometry x="40" y="52" width="1360" height="68" as="geometry" />
        </mxCell>

        <mxCell id="domain_badge" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;b style=&quot;color:#1E3A8A;font-size:13px;&quot;&gt;PHÂN VÙNG NGHIỆP VỤ TRÊN TẦNG 1:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#047857;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Nhánh Trái:&lt;/b&gt; Danh mục Sản phẩm (≥ 500 SKU) &amp;amp; Từ điển Da liễu INCI (4 trục Taxonomy)&lt;br&gt;&lt;span style=&quot;color:#1D4ED8;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Nhánh Giữa:&lt;/b&gt; Tài khoản Khách hàng, Đơn hàng HPOS (Combo Routine -15%) &amp;amp; Chi tiết dòng đơn&lt;br&gt;&lt;span style=&quot;color:#6D28D9;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Nhánh Phải:&lt;/b&gt; Giao dịch Thanh toán (COD / VietQR / VNPay HMAC-SHA512) &amp;amp; Hoàn tiền Store Credit&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;" vertex="1" parent="layer1">
          <mxGeometry x="1430" y="52" width="1050" height="68" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 1: Products (Top Left) ================= -->
        <mxCell id="tbl_products" value="1. BẢNG Products (Sản phẩm Chăm sóc Da ≥ 500 SKU)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#047857;strokeColor=#065F46;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="50" y="145" width="490" height="310" as="geometry" />
        </mxCell>
        <mxCell id="tbl_products_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#ECFDF5;border-bottom:1.5px solid #047857;font-weight:bold;color:#065F46;&quot;&gt;&lt;td width=&quot;16%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;36%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;20%&quot;&gt;Ràng buộc&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;product_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;UQ&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;sku&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;product_name&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;regular_price&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL (VNĐ)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;stock_quantity&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;stock_status&lt;/td&gt;&lt;td&gt;ENUM('instock','outofstock')&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;full_inci_list&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;NULL (Bảng INCI)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;is_strong_active&lt;/td&gt;&lt;td&gt;TINYINT(1)&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;is_gentle_fallback&lt;/td&gt;&lt;td&gt;TINYINT(1)&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#065F46;padding-top:4px;&quot;&gt;&lt;i&gt;• SKU chuẩn KLR-{hash8}; cờ _kleer_strong_active &amp;amp; _kleer_gentle_fallback lọc da nhạy cảm.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_products">
          <mxGeometry x="0" y="34" width="490" height="276" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 4: Product_Taxonomies (Middle Left) ================= -->
        <mxCell id="tbl_product_tax" value="4. BẢNG Product_Taxonomies (Liên kết Đa-Đa M:N)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#0D9488;strokeColor=#0F766E;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="50" y="510" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tbl_product_tax_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#CCFBF1;border-bottom:1.5px solid #0F766E;font-weight:bold;color:#115E59;&quot;&gt;&lt;td width=&quot;18%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;32%&quot;&gt;Tên trường&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;22%&quot;&gt;Tham chiếu FK&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#047857;&quot;&gt;PK, FK1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;product_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;→ Products.product_id&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#047857;&quot;&gt;PK, FK2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;term_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;→ Taxonomy_Terms.term_id&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#0F766E;padding-top:6px;&quot;&gt;&lt;i&gt;• Khóa chính ghép (product_id, term_id) chuẩn hóa 1NF: tách các thuộc tính đa trị khỏi bảng Products.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_product_tax">
          <mxGeometry x="0" y="34" width="490" height="116" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 3: Taxonomy_Terms (Bottom Left) ================= -->
        <mxCell id="tbl_taxonomy" value="3. BẢNG Taxonomy_Terms (Từ điển Da liễu &amp; Hoạt chất)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#047857;strokeColor=#065F46;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="50" y="705" width="490" height="175" as="geometry" />
        </mxCell>
        <mxCell id="tbl_taxonomy_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#ECFDF5;border-bottom:1.5px solid #047857;font-weight:bold;color:#065F46;&quot;&gt;&lt;td width=&quot;16%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;34%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;22%&quot;&gt;Ràng buộc&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;term_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;taxonomy_group&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;term_slug&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;term_name&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#065F46;padding-top:4px;&quot;&gt;&lt;i&gt;• 5 nhóm: pa_skin_type (oily, sensitive...), pa_skin_concern (acne...), pa_routine_step (cleanser, serum...), pa_active_ingredient (retinol, bha...), pa_brand.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_taxonomy">
          <mxGeometry x="0" y="34" width="490" height="141" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 2: Users (Top Center-Left) ================= -->
        <mxCell id="tbl_users" value="2. BẢNG Users (Khách hàng &amp; Quản trị viên)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#1D4ED8;strokeColor=#1E40AF;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="680" y="145" width="470" height="250" as="geometry" />
        </mxCell>
        <mxCell id="tbl_users_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#EFF6FF;border-bottom:1.5px solid #1D4ED8;font-weight:bold;color:#1E3A8A;&quot;&gt;&lt;td width=&quot;16%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;34%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;22%&quot;&gt;Ràng buộc&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;user_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;UQ&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;email&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;password_hash&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;full_name&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;phone&lt;/td&gt;&lt;td&gt;VARCHAR(20)&lt;/td&gt;&lt;td&gt;NULL (SĐT giao hàng)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;role&lt;/td&gt;&lt;td&gt;ENUM('customer','admin')&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;DATETIME&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#1E40AF;padding-top:4px;&quot;&gt;&lt;i&gt;• Lưu định danh người dùng; tách biệt khỏi Orders để đạt chuẩn 3NF.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_users">
          <mxGeometry x="0" y="34" width="470" height="216" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 6: Order_Items (Bottom Center-Left) ================= -->
        <mxCell id="tbl_order_items" value="6. BẢNG Order_Items (Chi tiết Dòng sản phẩm trong Đơn)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#0D9488;strokeColor=#0F766E;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="680" y="510" width="470" height="245" as="geometry" />
        </mxCell>
        <mxCell id="tbl_order_items_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#CCFBF1;border-bottom:1.5px solid #0F766E;font-weight:bold;color:#115E59;&quot;&gt;&lt;td width=&quot;16%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;34%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;22%&quot;&gt;Ràng buộc / FK&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;order_item_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#DBEAFE;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;FK1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;order_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;→ Orders.order_id&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#DBEAFE;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;FK2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;product_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;→ Products.product_id&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;quantity&lt;/td&gt;&lt;td&gt;INT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;unit_price&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;line_total&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#0F766E;padding-top:4px;&quot;&gt;&lt;i&gt;• Đạt chuẩn 2NF: lưu giá chốt tại thời điểm mua (unit_price), tách product_name về bảng Products.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_order_items">
          <mxGeometry x="0" y="34" width="470" height="211" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 5: Orders (Center Hub) ================= -->
        <mxCell id="tbl_orders" value="5. BẢNG Orders (Đơn hàng Trung tâm — Lưu trữ trên Bảng phẳng HPOS)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#1D4ED8;strokeColor=#1E40AF;strokeWidth=2.5;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="1290" y="145" width="540" height="410" as="geometry" />
        </mxCell>
        <mxCell id="tbl_orders_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#EFF6FF;border-bottom:1.5px solid #1D4ED8;font-weight:bold;color:#1E3A8A;&quot;&gt;&lt;td width=&quot;14%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;38%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;26%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;22%&quot;&gt;Ràng buộc / FK&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;order_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#DBEAFE;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;customer_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NULL (→ Users.user_id)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;billing_email&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;NOT NULL (Nhận QR)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;shipping_address&lt;/td&gt;&lt;td&gt;VARCHAR(500)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;order_status&lt;/td&gt;&lt;td&gt;VARCHAR(40)&lt;/td&gt;&lt;td&gt;NOT NULL (8 trạng thái)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;subtotal_amount&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#047857;&quot;&gt;bundle_discount_amount&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0 (-15%)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;shipping_fee&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;total_amount&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;return_reason&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;NULL (Lý do đổi trả)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;return_tracking_code&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;NULL (Mã vận đơn trả)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;created_at&lt;/td&gt;&lt;td&gt;DATETIME&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#1E40AF;padding-top:4px;&quot;&gt;&lt;i&gt;• Trạng thái: pending, on-hold, processing, completed, cancelled, return-requested, return-approved, refunded.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_orders">
          <mxGeometry x="0" y="34" width="540" height="376" as="geometry" />
        </mxCell>

        <!-- Note box under Orders for Order Lifecycle & Instant Refund trigger -->
        <mxCell id="orders_lifecycle_note" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;b style=&quot;color:#1E3A8A;&quot;&gt;QUY TẮC NGHIỆP VỤ ĐƠN HÀNG HPOS (KLEER):&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Combo Routine Bundle (-15%):&lt;/b&gt; Khi giỏ hàng có đủ ≥ 3 bước chăm sóc da khác nhau (&lt;i&gt;pa_routine_step&lt;/i&gt;), &lt;code&gt;CartComboService&lt;/code&gt; tự động tính &lt;code&gt;bundle_discount_amount = 15% × subtotal_amount&lt;/code&gt;.&lt;br&gt;2. &lt;b&gt;Instant Refund (Nhánh 1):&lt;/b&gt; Ngay khi khách nhập &lt;code&gt;return_tracking_code&lt;/code&gt; hợp lệ cho đơn lỗi/kích ứng, &lt;code&gt;InstantRefundService&lt;/code&gt; chuyển trạng thái đơn và tự động sinh bản ghi &lt;b&gt;Store_Credits&lt;/b&gt; (= 100% &lt;code&gt;total_amount&lt;/code&gt;) gửi qua Email mà không bắt khách chờ hàng về kho.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11.5;fontColor=#1F2937;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;" vertex="1" parent="layer1">
          <mxGeometry x="1290" y="695" width="540" height="185" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 7: Payment_Transactions (Top Right) ================= -->
        <mxCell id="tbl_payment" value="7. BẢNG Payment_Transactions (Giao dịch COD / VietQR / VNPay)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#6D28D9;strokeColor=#5B21B6;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="1970" y="145" width="510" height="295" as="geometry" />
        </mxCell>
        <mxCell id="tbl_payment_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#F5F3FF;border-bottom:1.5px solid #6D28D9;font-weight:bold;color:#4C1D95;&quot;&gt;&lt;td width=&quot;14%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;36%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;22%&quot;&gt;Ràng buộc / FK&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;transaction_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#DBEAFE;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;order_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;→ Orders.order_id&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;payment_method&lt;/td&gt;&lt;td&gt;ENUM('cod','vietqr','vnpay')&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;gateway_txn_ref&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;NULL (vnp_TxnNo)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;amount&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;signature_verified&lt;/td&gt;&lt;td&gt;TINYINT(1)&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;payment_status&lt;/td&gt;&lt;td&gt;ENUM('pending','paid','failed')&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;paid_at&lt;/td&gt;&lt;td&gt;DATETIME&lt;/td&gt;&lt;td&gt;NULL&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#5B21B6;padding-top:4px;&quot;&gt;&lt;i&gt;• Xác thực chữ ký số HMAC-SHA512 từ VNPay Sandbox &amp;amp; tạo QR Napas VietQR động.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_payment">
          <mxGeometry x="0" y="34" width="510" height="261" as="geometry" />
        </mxCell>

        <!-- ================= TABLE 8: Store_Credits (Bottom Right) ================= -->
        <mxCell id="tbl_store_credits" value="8. BẢNG Store_Credits (Mã Hoàn tiền nhanh Store Credit)" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fontColor=#FFFFFF;fillColor=#6D28D9;strokeColor=#5B21B6;strokeWidth=2;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="layer1">
          <mxGeometry x="1970" y="510" width="510" height="275" as="geometry" />
        </mxCell>
        <mxCell id="tbl_store_credits_body" value="&lt;table style=&quot;width:100%;font-size:12px;border-collapse:collapse;color:#111827;&quot; cellpadding=&quot;4&quot;&gt;
&lt;tr style=&quot;background:#F5F3FF;border-bottom:1.5px solid #6D28D9;font-weight:bold;color:#4C1D95;&quot;&gt;&lt;td width=&quot;16%&quot;&gt;Khóa&lt;/td&gt;&lt;td width=&quot;34%&quot;&gt;Tên trường (Field)&lt;/td&gt;&lt;td width=&quot;26%&quot;&gt;Kiểu dữ liệu&lt;/td&gt;&lt;td width=&quot;24%&quot;&gt;Ràng buộc / FK&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#FEF3C7;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;credit_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;NOT NULL, AI&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;UQ&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;coupon_code&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VARCHAR(64)&lt;/td&gt;&lt;td&gt;UNIQUE, NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background:#DBEAFE;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;FK, UQ&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;source_order_id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;BIGINT UNSIGNED&lt;/td&gt;&lt;td&gt;UNIQUE → Orders.order_id&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;customer_email&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;credit_amount&lt;/td&gt;&lt;td&gt;DECIMAL(12,2)&lt;/td&gt;&lt;td&gt;NOT NULL (= 100% đơn)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;is_redeemed&lt;/td&gt;&lt;td&gt;TINYINT(1)&lt;/td&gt;&lt;td&gt;NOT NULL, DEF 0 (0/1)&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;border-bottom:1px solid #E5E7EB;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;issued_at&lt;/td&gt;&lt;td&gt;DATETIME&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;div style=&quot;font-size:11px;color:#5B21B6;padding-top:4px;&quot;&gt;&lt;i&gt;• Mã chuẩn KLR-CREDIT-{ORDER_ID}-{HASH}; phát hành tức thì khi có mã vận đơn trả hàng.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;" vertex="1" parent="tbl_store_credits">
          <mxGeometry x="0" y="34" width="510" height="241" as="geometry" />
        </mxCell>

        <!-- ================= RELATIONSHIP EDGES (NON-OVERLAPPING CROW'S FOOT) ================= -->
