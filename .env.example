# ============================================
# KLEER - Cấu hình môi trường (copy file này thành .env)
# KHÔNG commit file .env vào Git!
# ============================================

# --- Docker Ports ---
NGINX_PORT=80
NGINX_HOST=localhost
PHPMYADMIN_PORT=8080

# --- Database (MariaDB) ---
MYSQL_ROOT_PASSWORD=root_password_here_change_me
MYSQL_DATABASE=kleer_db
MYSQL_USER=kleer_user
MYSQL_PASSWORD=kleer_password_here_change_me
MYSQL_ROOT_HOST=%

# --- WordPress ---
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=kleer_db
WORDPRESS_DB_USER=kleer_user
WORDPRESS_DB_PASSWORD=kleer_password_here_change_me
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false

# --- WordPress Salts (từ https://api.wordpress.org/secret-key/1.1/salt/) ---
AUTH_KEY=put_your_unique_phrase_here
SECURE_AUTH_KEY=put_your_unique_phrase_here
LOGGED_IN_KEY=put_your_unique_phrase_here
NONCE_KEY=put_your_unique_phrase_here
AUTH_SALT=put_your_unique_phrase_here
SECURE_AUTH_SALT=put_your_unique_phrase_here
LOGGED_IN_SALT=put_your_unique_phrase_here
NONCE_SALT=put_your_unique_phrase_here

# --- Application ---
WP_SITEURL=http://${NGINX_HOST}:${NGINX_PORT}
WP_HOME=http://${NGINX_HOST}:${NGINX_PORT}
WP_ENV=local

# --- Redis (nếu cần) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS cho REST API (L01-G6-01) ---
# Danh sách origin được phép, cách nhau bằng dấu phẩy.
# Bỏ trống = chặn mọi cross-origin request (an toàn nhất cho production nếu chưa cấu hình).
# Dùng dấu * để cho phép mọi origin — KHÔNG dùng khi bật KLEER_CORS_ALLOW_CREDENTIALS=true.
KLEER_CORS_ALLOWED_ORIGINS=http://localhost:${NGINX_PORT},http://localhost:3000,http://localhost:5173
KLEER_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
KLEER_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-WP-Nonce,X-KLEER-Session
# Bật true nếu Frontend gọi API bằng cookie/nonce (X-WP-Nonce). Khi đó bắt buộc
# khai báo origin tường minh, không dùng dấu *.
KLEER_CORS_ALLOW_CREDENTIALS=false
# Thoi gian cache preflight (giay).
KLEER_CORS_MAX_AGE=86400

# --- Mailhog (tùy chọn) ---
# MAILHOG_PORT=1025
# MAILHOG_UI_PORT=8025
