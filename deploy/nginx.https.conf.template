# ============================================
# Nginx configuration for WordPress (KLEER) - PRODUCTION / HTTPS
# ============================================
#
# File nay la TEMPLATE. deploy/deploy.sh thay __SERVER_NAME__ bang domain cua ban
# va ghi ket qua ra deploy/nginx.https.conf, sau do docker-compose.prod.yml
# mount file da render do vao container.
#
# KHONG duoc sua file nay truc tiep tren VPS. Sua o day roi deploy lai.
#
# Yeu cau: mDNS phai tro ve may chu truoc khi chay certbot.

upstream kleer_php {
    server php:9000;
    keepalive 16;
}

# ============================================
# HTTP -> chuyen huong HTTPS
# ============================================
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # ACME challenge phai chay qua HTTP, nen khong redirect o khu vuc nay.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ============================================
# HTTPS
# ============================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SERVER_NAME__;

    ssl_certificate     /etc/letsencrypt/live/__SERVER_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SERVER_NAME__/privkey.pem;

    # TLS 1.2 tro len. TLS 1.0/1.1 da bi loai bo khoi RFC 8996.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP stapling: giam thoi gian handshake.
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=300s;
    resolver_timeout 5s;

    root /var/www/html;
    index index.php index.html;

    # ============================================
    # Security headers
    # ============================================
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # ============================================
    # Upload size - Large images for products
    # ============================================
    client_max_body_size 100M;
    client_body_buffer_size 128k;
    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;
    proxy_read_timeout 300;
    fastcgi_read_timeout 300;

    # ============================================
    # Static file caching
    # ============================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ============================================
    # Pretty Permalinks - WordPress rewrite
    # ============================================
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # ============================================
    # PHP-FPM handling
    # ============================================
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass kleer_php;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_keep_conn on;
    }

    # ============================================
    # Deny access to hidden files
    # ============================================
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # ============================================
    # Deny access to sensitive files
    # ============================================
    location ~* (wp-config\.php|readme\.html|license\.txt|\.htaccess|xmlrpc\.php) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Cache drop-in khong duoc truy cap truc tiep qua HTTP.
    location ~* ^/wp-content/(object-cache|advanced-cache|db|db-error)\.php$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # ============================================
    # WooCommerce uploads
    # ============================================
    location /wp-content/uploads/ {
        access_log off;
        expires max;
        add_header Cache-Control "public, immutable";
    }

    # ============================================
    # Health check endpoint
    # ============================================
    location = /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # ============================================
    # Access & Error logs
    # ============================================
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;
}
