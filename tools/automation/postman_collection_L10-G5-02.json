          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}?rest_route=/wc/v3/products/{{product_stock_id}}&force=true",
            "description": ""
          }
        },
        {
          "name": "4.2 DELETE don hang test",
          "event": [
            {
              "listen": "test",
